# Dawnline
#
# Stillwater, a farming colony in a canyon on the night side of Mereth, has forty minutes
# before the sunrise reaches it. Take orbit, send people down, and find a way to get two
# hundred and twelve colonists through the Dawnline.
#
# THE SHAPE. This file holds no story. The ground is `surface/*.tiles`, the things on it
# and the people you can talk to are `world.amd`, every word said is `scenes.amd`, and the
# mission's own vocabulary is `lp_world.py`. This script builds the world, runs the clock,
# connects the bridge to the ground, and decides when it is over.


# The mission's own vocabulary: tiles, the tally, the ending. Every function is `lp_`.
import lp_world.py


# How long the night lasts once the party is down, in minutes. Read from SETTINGS in the
# map body (see there) so a profile or COSMOS_SETTINGS can shorten it for a test.
default shared LP_DAWN_LEFT = 0
default shared LP_OVER = False
# The two orbit answers, spelled exactly as `world.amd` offers them.
default shared LP_ACCEPT = "Assemble a boarding party"
# Where Mereth sits. The players spawn near it and take orbit.
default shared LP_WORLD_X = 0
default shared LP_WORLD_Y = 0
default shared LP_WORLD_Z = 16000


#region sides
lp_tsn = await prefab_spawn(prefab_side_generic, data={"key":"tsn", "name": "TSN", "color": "#07F", "desc":"The Terran Stellar Navy"})
lp_raider = await prefab_spawn(prefab_side_generic, data={"key":"raider", "name": "Raider", "color": "#F00", "desc":"Salvage crews, and worse"})
side_set_relations(lp_tsn, lp_raider, sbs.DIPLOMACY.HOSTILE)
#endregion

@media/music/default "Cosmos Default Music"
@media/skybox/sky-bored-alice "borealis"


@map/landing_party "Dawnline"
metadata: ``` yaml
Properties:
    Player Ships: 'gui_int_slider("$text:int;low: 1.0;high:8.0;", var= "PLAYER_COUNT")'
    Difficulty: 'gui_int_slider("$text:int;low: 1.0;high:11.0;", var= "DIFFICULTY")'
Defaults:
    CREW_SELECT: landing_crew
```
    " Forty minutes of night, two hundred and twelve colonists, and three ways out.

    logger(name="landing", file="landing.txt")
    log("map body running", "landing")

    # The crew, and what each of them is good at. Same file, two readers - the roster and
    # the Skills: fields - which is why it is its own file.
    crew_load_amd("landing_crew.amd")
    shared CREW_SELECT = "landing_crew"
    lp_crew_doc = document_get_amd_file(get_mission_dir_filename("landing_crew.amd"))
    boarding_skills_from_amd(lp_crew_doc)

    # A new game: nothing done yet.
    lp_reset()
    lp_install()
    boarding_metric_install()
    lp_setup_tiles()
    lp_areas = lp_load_areas()
    if lp_areas != 6:
        print(f"LandingParty: only {lp_areas} of 6 areas loaded")

    lp_doc = document_get_amd_file(get_mission_dir_filename("world.amd"), data_parser=amd_mission_data)
    lp_scene_doc = document_get_amd_file(get_mission_dir_filename("scenes.amd"), data_parser=amd_mission_data)
    shared LP_SCENES = dialogue_scenes(amd_section(lp_scene_doc, "scenes"))
    shared LP_HAILS = dialogue_scenes(amd_section(lp_doc, "hails"))
    shared LP_SIDE = amd_section(lp_doc, "side_stories")

    # The ground: props, the people you can talk to, and what is out there hunting heat.
    boarding_props_scenes(LP_SCENES)
    boarding_props_declare(amd_section(lp_doc, "props"))
    boarding_props_place()
    boarding_hostiles_declare(amd_section(lp_doc, "people"))
    boarding_hostiles_declare(amd_section(lp_doc, "hostiles"))
    boarding_hostiles_place()
    boarding_props_install()
    boarding_combat_install()
    tilemap_watch()

    # The whole crew's story, on the game itself.
    lp_grant_story(amd_section(lp_doc, "quests"))

    #region the system
    await prefab_spawn(prefab_gas_giant, data={
        "name": "Mereth",
        "planet_radius": 3500,
        "START_X": LP_WORLD_X, "START_Y": LP_WORLD_Y, "START_Z": LP_WORLD_Z})
    shared LP_WORLD_ID = next(iter(role("gasgiant")), None)
    if LP_WORLD_ID is None:
        print("LandingParty: no planet spawned - the orbit can never fire")
    #endregion

    await task_schedule(spawn_players)
    await task_schedule(docking_standard_player_gas_giant)
    for lp_ship in to_object_list(role("__player__")):
        if LP_WORLD_ID is not None:
            link(lp_ship.id, "extra_scan_source", LP_WORLD_ID)

    game_end_condition_add(destroyed_all(role("__player__")), "All ships lost. Stillwater faces the dawn alone.", False)

    task_schedule(lp_picket)

    # settings_get_defaults(), not a bare `default shared`: settings.yaml, a profile and
    # COSMOS_SETTINGS all feed the SETTINGS table, and none of them seeds a shared.
    lp_settings = settings_get_defaults()
    shared LP_DAWN_LEFT = int(lp_settings.get("LP_DAWN_MINUTES", 40) or 40) * 60
    if lp_settings.get("LP_CHECK_MODE", "dice") == "flat":
        boarding_checks_mode("flat")
    lp_seed = lp_settings.get("LP_SEED", 0)
    if lp_seed:
        boarding_checks_seed(lp_seed)
    lp_auto = lp_settings.get("LP_AUTO_BEAM", 0)
    ->END if lp_auto is None or lp_auto <= 0

    # Development only: reach the ground without flying to the planet, so a headless run
    # exercises the away half.
    await delay_sim(lp_auto)
    signal_emit("lp_beam_down")
    ->END


# The Gnaw's escort. While it is near Mereth it jams the transporter - the party walks, or
# the bridge deals with it. Small on purpose: this is not a fleet action.
=== lp_picket
    await delay_sim(90)
    lp_fleet_pos = Vec3.rand_in_sphere(6000, 9000, False, True)
    lp_fleet_data = {"race": "skaraan", "fleet_difficulty": int(max(0, DIFFICULTY - 4)), "START_X": LP_WORLD_X + lp_fleet_pos.x, "START_Y": 0, "START_Z": LP_WORLD_Z + lp_fleet_pos.z}
    prefab_spawn(prefab_fleet_raider, lp_fleet_data)
---lp_picket_watch
    await delay_sim(5)
    ->END if LP_OVER
    lp_jammers = 0
    for lp_raider_obj in to_object_list(role("raider")):
        if LP_WORLD_ID is not None and sbs.distance_id(lp_raider_obj.id, LP_WORLD_ID) < 15000:
            lp_jammers += 1
    if lp_jammers > 0 and not boarding_transport_jammed():
        boarding_transport_jam(True, "A Skaraan raider in orbit is jamming the transporter")
    if lp_jammers == 0 and boarding_transport_jammed():
        boarding_transport_jam(False)
    jump lp_picket_watch


# The Dawnline. Beats at 30, 20, 10, 5 and 1 minutes left; at zero the ship lifts who it can.
=== lp_dawn_clock
    lp_beats = [1800, 1200, 600, 300, 60]
---lp_dawn_tick
    await delay_sim(5)
    ->END if LP_OVER
    LP_DAWN_LEFT = LP_DAWN_LEFT - 5
    for lp_beat in lp_beats:
        if LP_DAWN_LEFT <= lp_beat and LP_DAWN_LEFT > lp_beat - 5:
            lp_min = lp_beat // 60
            message_send(f"The Dawnline is {lp_min} minutes from Stillwater.", to="boarding", kind="alert", sender="Stillwater")
            comms_broadcast(role("__player__"), f"Dawnline: {lp_min} minutes to Stillwater.", "#fa4")
    jump lp_dawn_tick if LP_DAWN_LEFT > 0
    task_schedule(lp_finish, {"lp_trigger": "dawn"})
    ->END


#############################################################################
# Routes. At the END of the file: labels fall through, routes do not, so anything
# added above this line must not run on into them.
#############################################################################

# Taking orbit is the starting gun. The hail is awaitable and server arbitrated, so with
# six consoles the answer still fires once.
//shared/signal/ship_orbiting
    ->END if LP_OVER
    ->END if not has_role(ORBIT_BODY_ID, "gasgiant")
    ->END if get_inventory_value(ORBIT_SHIP_ID, "LP_HAILED", False)
    ->END if boarding_invitation() is not None
    set_inventory_value(ORBIT_SHIP_ID, "LP_HAILED", True)
    lp_call = await hail_ask(ORBIT_SHIP_ID, scene="orbit_call", scenes=LP_HAILS)
    ->END if lp_call is None
    log(f"orbit hail answered: {lp_call.value}", "landing")
    if lp_call.value == LP_ACCEPT:
        await delay_sim(4)
        signal_emit("lp_beam_down")
    else:
        # Not now. Leaving orbit and coming back offers the call again.
        set_inventory_value(ORBIT_SHIP_ID, "LP_HAILED", False)
    ->END


# Open the party. Each console beams down from its ePADD as its own crew member, onto the
# landing ridge; the crew console draws the ground as a tile map.
//shared/signal/lp_beam_down
    ->END if boarding_invitation() is not None
    lp_ship = next(iter(role("__player__")), None)
    ->END if lp_ship is None
    lp_invite = boarding_invite_crew(lp_ship, title="Stillwater", area="ridge")
    if len(lp_invite.get("roster") or []) == 0:
        print("LandingParty: no crew at the consoles to send down")
    task_schedule(lp_dawn_clock)
    log(f"beam down: roster={len(lp_invite.get('roster') or [])}", "landing")
    # Development only: send every console down without anyone pressing BEAM DOWN, so an
    # engine run can look at the ground with no mouse. `var.LP_AUTO_GO=1`.
    if SETTINGS.get("LP_AUTO_GO", 0):
        task_schedule(lp_auto_go, {"lp_go_ship": lp_ship})
    ->END


=== lp_auto_go
    await delay_sim(2)
    for lp_go_cid in sorted(linked_to(lp_go_ship, "consoles")):
        if boarding_beam_down(lp_go_cid) is not None:
            boarding_go_down(lp_go_cid)
    # Development only (`var.LP_PROBE_AREA=gnaw`, optionally `var.LP_PROBE_AT=13,4`):
    # stand everyone in another area, so an engine run can look at it with no mouse.
    lp_probe_area = SETTINGS.get("LP_PROBE_AREA", "")
    if lp_probe_area:
        await delay_sim(1)
        lp_probe_at = [int(v) for v in str(SETTINGS.get("LP_PROBE_AT", "")).replace(",", " ").split()]
        if len(lp_probe_at) != 2:
            lp_probe_at = tilemap_entry(lp_probe_area)
        for lp_go_cid in sorted(linked_to(lp_go_ship, "consoles")):
            tilemap_place(boarding_me(lp_go_cid), lp_probe_area, lp_probe_at[0], lp_probe_at[1])
    ->END if not SETTINGS.get("LP_PROBE_PICK", 0)
    # Development only (`var.LP_PROBE_PICK=1`): open the drone's scene and, a while
    # later, pick its first choice through the same signal the button sends - an engine
    # check of the Act redraw that needs no mouse.
    await delay_sim(6)
    for lp_go_cid in sorted(linked_to(lp_go_ship, "consoles")):
        boarding_interact(lp_go_cid, "drone")
    for lp_probe_n in range(2):
        await delay_sim(10)
        for lp_go_cid in sorted(linked_to(lp_go_ship, "consoles")):
            signal_emit("boarding_pick", {"SIGNAL_CLIENT_ID": lp_go_cid, "i": "0", "seq": str(boarding_seq_for(lp_go_cid)), "SIGNAL_CHOICE": "probe"})
            log(f"probe pick {lp_probe_n} at tick {sim.time_tick_counter} for {lp_go_cid}: scene now {boarding_scene(boarding_channel_of(lp_go_cid))} rev {boarding_reader_revision(lp_go_cid)}", "landing")
    ->END


# Each crew member picks up their own side story when they land.
//shared/signal/boarding_went_down
    ->END if LP_SIDE is None
    boarding_quests_grant(LP_SIDE)
    ->END


//shared/signal/lp_met_magistrate
    lp_reveal_ways()
    # Anyone who has not claimed their side story by now is not coming.
    boarding_quests_open_unclaimed(LP_SIDE)
    ->END


# The seated core asks the bridge for power.
//shared/signal/lp_power_ready
    ->END if lp_is("powered")
    lp_ship = next(iter(role("__player__")), None)
    ->END if lp_ship is None
    await hail_ask(lp_ship.id, scene="lantern_power", scenes=LP_HAILS)
    ->END


# Everyone on the ground is down. Nobody is stranded: they come round at the edge of the
# area, away from what dropped them - and the night is two minutes shorter.
//shared/signal/boarding_party_down
    ->END if LP_OVER
    await delay_sim(8)
    for lp_down in boarding_team():
        if boarding_is_down(lp_down):
            lp_down_at = tilemap_where(lp_down)
            boarding_revive(lp_down, 1)
            if lp_down_at is not None:
                lp_entry = tilemap_entry(lp_down_at[0])
                tilemap_place(lp_down, lp_down_at[0], lp_entry[0], lp_entry[1])
    LP_DAWN_LEFT = max(60, LP_DAWN_LEFT - 120)
    message_send("You come to at the edge of the site, bruised. Two minutes of night are gone.", to="boarding", kind="alert", sender="Stillwater")
    ->END


# The ways out. Each one ends the night.
//shared/signal/lp_launch
    task_schedule(lp_finish, {"lp_trigger": "launch"})
    ->END

//shared/signal/lp_wake_true
    signal_emit("lp_wake")
    task_schedule(lp_finish, {"lp_trigger": "wake_true"})
    ->END

//shared/signal/lp_wake_false
    signal_emit("lp_wake")
    task_schedule(lp_finish, {"lp_trigger": "wake_false"})
    ->END

//shared/signal/lp_bargain_good
    signal_emit("lp_bargain")
    task_schedule(lp_finish, {"lp_trigger": "bargain_good"})
    ->END

//shared/signal/lp_bargain_core
    signal_emit("lp_bargain")
    task_schedule(lp_finish, {"lp_trigger": "bargain_core"})
    ->END


# End it - but let the party read the end of their own scene first.
=== lp_finish
    ->END if LP_OVER
    LP_OVER = True
    lp_end = lp_ending(lp_trigger)
    signal_emit("lp_saved")
    log(f"finish: {lp_end[0]} saved={lp_end[3]} lantern={lp_end[4]} glyphs={lp_end[5]} sides={lp_end[6]}", "landing")
    await delay_sim(4)
    START_TEXT = lp_ending_text()
    if lp_end[3] > 100:
        music_play_sting("victory")
    else:
        music_play_sting("failure")
    GAME_STARTED = False
    GAME_ENDED = True
    signal_emit("show_game_results", None)
    ->END
